# Copy to .env and fill in your own key. Never commit .env.
OPENAI_API_KEY=sk-your-key-here
MM_CHAT_MODEL=gpt-4o-mini
MM_STT_MODEL=gpt-4o-transcribe-diarize
MM_STT_FALLBACK=whisper-1
MM_EMBED_MODEL=text-embedding-3-small
MM_TTS_MODEL=gpt-4o-mini-tts
# optional: off | auto (default) | always - second, self-enrolled diarization pass
MM_ENROL=auto
